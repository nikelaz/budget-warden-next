<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BudgetWarden_Windows.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BudgetWarden_Windows"
    xmlns:models="using:BudgetWarden_Windows.Services"
    xmlns:viewModels="using:BudgetWarden_Windows.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="MainPage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid
            x:Name="WelcomeView"
            Visibility="{x:Bind Vm.ShowWelcome, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Padding="36,36,36,36"
                Spacing="24"
                VerticalAlignment="Center">
                <Image
                    Width="104"
                    Height="104"
                    HorizontalAlignment="Left"
                    Source="Assets/BudgetWarden.svg"
                    AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Budget Warden"
                        Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel Spacing="16">
                    <Button
                    x:Name="WelcomeNewBudgetButton"
                    Click="NewBudget_Click"
                    AutomationProperties.Name="Create new budget"
                    AutomationProperties.AutomationId="WelcomeNewBudgetButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Create new budget" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                    x:Name="WelcomeOpenBudgetButton"
                    Click="OpenBudget_Click"
                    AutomationProperties.Name="Open budget"
                    AutomationProperties.AutomationId="WelcomeOpenBudgetButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Open budget" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StackPanel>
            <Border
                Grid.Column="1"
                Margin="0,16,16,16"
                Padding="36"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Recently opened"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Your most recent .budget files stay on this device."
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ListView
                        x:Name="RecentBudgetsList"
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="0"
                        ItemsSource="{x:Bind Vm.RecentFiles, Mode=OneWay}"
                        SelectionMode="None"
                        AutomationProperties.AutomationId="RecentBudgetsList"
                    >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecentBudget">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OpenRecent_Click"
                                    Margin="0, 0, 0, 8"
                                    AutomationProperties.AutomationId="{x:Bind Path, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                    <Grid Padding="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Margin="0,0,16,0" Glyph="&#xE8A5;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind Folder, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Visibility="{x:Bind Vm.HasBudget, Mode=OneWay}"
            Loaded="ShellNavigation_Loaded"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            SelectionChanged="ShellNavigation_SelectionChanged"
            AutomationProperties.AutomationId="ShellNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="BudgetNavigationItem"
                    Content="Budget"
                    Icon="Home"
                    IsSelected="True"
                    Tag="budget"
                    AutomationProperties.AutomationId="NavBudget" />
                <NavigationViewItem
                    Content="Reporting"
                    Icon="Document"
                    Tag="reporting"
                    AutomationProperties.AutomationId="NavReporting" />
                <NavigationViewItem
                    Content="Transactions"
                    Icon="List"
                    Tag="transactions"
                    AutomationProperties.AutomationId="NavTransactions" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Padding="8" Spacing="4">
                    <TextBlock
                        Text="{x:Bind Vm.BudgetTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="CloseBudget_Click"
                        AutomationProperties.Name="Close budget"
                        AutomationProperties.AutomationId="CloseBudgetButton">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8BB;" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Close budget" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid x:Name="BudgetPage" x:Load="{x:Bind Vm.IsBudgetPage, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right">
                            <AppBarButton
                                Icon="Add"
                                Label="New category"
                                Click="NewCategory_Click"
                                AutomationProperties.AutomationId="NewCategoryButton" />
                            <AppBarButton
                                Icon="Add"
                                Label="New transaction"
                                Click="NewTransaction_Click"
                                AutomationProperties.AutomationId="NewTransactionButton" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton
                                    Icon="OpenFile"
                                    Label="Open budget"
                                    Click="OpenBudget_Click"
                                    AutomationProperties.AutomationId="OpenBudgetButton" />
                                <AppBarButton
                                    Icon="Page"
                                    Label="New budget"
                                    Click="NewBudget_Click"
                                    AutomationProperties.AutomationId="NewBudgetButton" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                        <Grid Grid.Row="1" Margin="24,8,24,24" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Budget" Style="{StaticResource TitleTextBlockStyle}" />
                                <Grid Grid.Row="1" Margin="12,20,12,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" Text="Planned" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="3" Text="Actual" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="4" Text="Accumulated" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ListView
                                    x:Name="CategoryList"
                                    Grid.Row="2"
                                    ItemsSource="{x:Bind Vm.Categories, Mode=OneWay}"
                                    SelectedItem="{x:Bind Vm.SelectedCategory, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    AutomationProperties.AutomationId="CategoryList">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:CategoryRowViewModel">
                                            <Grid Padding="12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Type, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Planned, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Actual, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind Accumulated, Mode=OneWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            <Border
                                x:Name="CategoryInspector"
                                Grid.Column="1"
                                x:Load="{x:Bind Vm.HasSelectedCategory, Mode=OneWay}"
                                Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Category details" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedCategory.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedCategory.Type, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="Planned" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedCategory.Planned, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock Text="Actual" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedCategory.Actual, Mode=OneWay, FallbackValue=''}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="EditCategory_Click"
                                        AutomationProperties.AutomationId="EditCategoryButton"
                                        Content="Edit category" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="TransactionForCategory_Click"
                                        AutomationProperties.AutomationId="TransactionForCategoryButton"
                                        Content="Add transaction" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="DeleteCategory_Click"
                                        AutomationProperties.AutomationId="DeleteCategoryButton"
                                        Content="Delete category" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ReportingPage" x:Load="{x:Bind Vm.IsReportingPage, Mode=OneWay}" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Reporting" Style="{StaticResource TitleTextBlockStyle}" />
                        <Grid Grid.Row="1" Margin="0,20,0,24" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8"><TextBlock Text="Income" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{x:Bind Vm.IncomeTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8"><TextBlock Text="Planned allocation" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{x:Bind Vm.PlannedAllocationTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8"><TextBlock Text="Actual allocation" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{x:Bind Vm.ActualAllocationTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8"><TextBlock Text="Left to budget" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{x:Bind Vm.LeftToBudgetTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" /></StackPanel>
                            </Border>
                        </Grid>
                        <ListView
                            Grid.Row="2"
                            ItemsSource="{x:Bind Vm.ReportingRows, Mode=OneWay}"
                            SelectionMode="None"
                            AutomationProperties.AutomationId="ReportingList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ReportingRowViewModel">
                                    <Grid Padding="12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Type, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Planned, Mode=OneWay}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Actual, Mode=OneWay}" />
                                        <ProgressBar Grid.Column="4" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="TransactionsPage" x:Load="{x:Bind Vm.IsTransactionsPage, Mode=OneWay}" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Transactions" Style="{StaticResource TitleTextBlockStyle}" />
                            <Button Grid.Column="1" Click="NewTransaction_Click" Content="New transaction" AutomationProperties.AutomationId="TransactionsNewButton" />
                        </Grid>
                        <AutoSuggestBox
                            Grid.Row="1"
                            Margin="0,20,0,16"
                            QueryIcon="Find"
                            PlaceholderText="Search transactions"
                            Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.AutomationId="TransactionSearchBox" />
                        <Grid Grid.Row="2" ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                            <ListView
                                ItemsSource="{x:Bind Vm.Transactions, Mode=OneWay}"
                                SelectedItem="{x:Bind Vm.SelectedTransaction, Mode=TwoWay}"
                                SelectionMode="Single"
                                AutomationProperties.AutomationId="TransactionList">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TransactionRowViewModel">
                                        <Grid Padding="12" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Category, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Date, Mode=OneWay}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Amount, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border
                                x:Name="TransactionInspector"
                                Grid.Column="1"
                                x:Load="{x:Bind Vm.HasSelectedTransaction, Mode=OneWay}"
                                Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Transaction details" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedTransaction.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedTransaction.Category, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedTransaction.Date, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedTransaction.Amount, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedTransaction.Description, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="DeleteTransaction_Click"
                                        Content="Delete transaction"
                                        AutomationProperties.AutomationId="DeleteTransactionButton" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPage" x:Load="{x:Bind Vm.IsSettingsPage, Mode=OneWay}" Padding="24">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="24">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <Border
                                Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Currency" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Used to display money throughout the app." Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind Vm.CurrencyOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind Vm.SelectedCurrency, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        AutomationProperties.Name="Currency"
                                        AutomationProperties.AutomationId="CurrencyComboBox" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Budget Warden for Windows" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Your .budget files remain portable across macOS, iOS, Android, and Windows." TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
