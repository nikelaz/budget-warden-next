<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetWarden_Windows.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BudgetWarden_Windows.Views"
    xmlns:viewModels="using:BudgetWarden_Windows.ViewModels">
    <ScrollViewer Padding="30">
        <StackPanel
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                Text="Settings"
                Margin="0,0,0,10"
                Style="{StaticResource TitleTextBlockStyle}" />
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Currency"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <AutoSuggestBox
                        x:Name="CurrencyBox"
                        Grid.Column="1"
                        MinWidth="300"
                        PlaceholderText="Search by currency name or code"
                        QueryIcon="Find"
                        TextChanged="CurrencyBox_TextChanged"
                        SuggestionChosen="CurrencyBox_SuggestionChosen"
                        QuerySubmitted="CurrencyBox_QuerySubmitted"
                        LostFocus="CurrencyBox_LostFocus"
                        AutomationProperties.Name="Currency"
                        AutomationProperties.AutomationId="CurrencySearchBox" />
                </Grid>
            </Border>
            <Border
                Padding="24"
                MaxWidth="720"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="MCP Server"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="MCP clients such as AI assistants can read and edit your open and recent budgets through this URL while Budget Warden is running. Keep it private."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch
                        x:Name="McpEnabledSwitch"
                        Header="Enable MCP server"
                        IsOn="{x:Bind Vm.IsMcpServerEnabled, Mode=OneWay}"
                        Toggled="McpEnabledSwitch_Toggled"
                        AutomationProperties.AutomationId="McpEnabledSwitch" />
                    <ToggleSwitch
                        x:Name="McpNetworkSwitch"
                        Header="Allow other devices on this network"
                        IsOn="{x:Bind Vm.McpServerAllowsNetwork, Mode=OneWay}"
                        Toggled="McpNetworkSwitch_Toggled"
                        AutomationProperties.AutomationId="McpNetworkSwitch" />
                    <TextBlock
                        Text="{x:Bind Vm.McpServerError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind local:ViewVisibility.When(Vm.HasMcpServerError), Mode=OneWay}" />
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind local:ViewVisibility.When(Vm.HasMcpServerUrl), Mode=OneWay}">
                        <TextBox
                            Header="Server URL"
                            IsReadOnly="True"
                            FontFamily="Consolas"
                            Text="{x:Bind Vm.McpServerUrl, Mode=OneWay}"
                            AutomationProperties.AutomationId="McpServerUrl" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Copy URL"
                                Click="CopyMcpUrl_Click"
                                AutomationProperties.AutomationId="CopyMcpUrlButton" />
                            <Button
                                Content="Generate new URL"
                                Click="RegenerateMcpUrl_Click"
                                AutomationProperties.AutomationId="RegenerateMcpUrlButton" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
