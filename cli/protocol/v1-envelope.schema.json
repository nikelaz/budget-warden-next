{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Budget Warden CLI response envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "ok", "data", "error", "meta"],
  "properties": {
    "protocol_version": {"const": 1},
    "ok": {"type": "boolean"},
    "data": {},
    "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["code", "message", "details", "retryable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {}, "retryable": {"type": "boolean"}, "commit_outcome": {"enum": ["not_written", "written", "unknown"]}}}]},
    "meta": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["command"], "properties": {"command": {"type": "string"}, "budget_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer"}, "revision_id": {"type": "string", "format": "uuid"}, "write_occurred": {"type": "boolean"}, "migration_status": {"enum": ["current", "required"]}}}]}
  }
}
